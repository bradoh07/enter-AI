create policy project_inputs_update_own on public.project_inputs for update using (auth.uid() = user_id) with check (auth.uid() = user_id);
create policy project_inputs_delete_own on public.project_inputs for delete using (auth.uid() = user_id);

create trigger project_inputs_set_updated_at before update on public.project_inputs
