-- ============ simulation_runs ============
create table public.simulation_runs (
  id uuid primary key default gen_random_uuid(),
  project_id uuid not null references public.projects(id) on delete cascade,
  user_id uuid not null references auth.users(id) on delete cascade,
  run_number integer not null default 1,
  label text,
  engine_version text not null default '1.0.0',
  input_snapshot jsonb not null default '{}'::jsonb,
  results jsonb not null default '{}'::jsonb,
  assumptions jsonb not null default '[]'::jsonb,
  ai_insights jsonb,
  ai_status text not null default 'not_requested',
  ai_error text,
  ai_model text,
  created_at timestamptz not null default now(),
  constraint simulation_runs_ai_status_check check (ai_status in ('not_requested','ok','unavailable','error')),
  constraint simulation_runs_project_run_key unique (project_id, run_number)
);

create index simulation_runs_user_id_created_at_idx on public.simulation_runs (user_id, created_at desc);

alter table public.simulation_runs enable row level security;

create policy simulation_runs_select_own on public.simulation_runs for select using (auth.uid() = user_id);
create policy simulation_runs_insert_own on public.simulation_runs for insert with check (auth.uid() = user_id);
create policy simulation_runs_update_own on public.simulation_runs for update using (auth.uid() = user_id) with check (auth.uid() = user_id);
create policy simulation_runs_delete_own on public.simulation_runs for delete using (auth.uid() = user_id);
